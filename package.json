{
  "name": "neon-exchange",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check dist/app.js && node --check dist/engine.js",
    "build": "node build.mjs",
    "test:fork": "node --test tests/fork.integration.mjs",
    "build:lab": "node scripts/build-lab.mjs",
    "testnet": "node scripts/build-lab.mjs && node scripts/lab-server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "ganache": "7.9.2"
  },
  "packageManager": "pnpm@11.19.0"
}
